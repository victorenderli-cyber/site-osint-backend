# Copie para .env (nunca commite o .env com segredos)
# Hotmart (fluxo principal)
HOTMART_HOTTOK=SEU-SEGREDO-DO-HOTTOK
HOTMART_CHECKOUT_URL=https://go.hotmart.com/SEU-CODIGO
# Mercado Pago (fluxo alternativo "Já paguei")
MP_ACCESS_TOKEN=SEU-ACCESS-TOKEN-DO-MERCADO-PAGO
# E-mail (um dos dois; ordem: Make, Brevo, SMTP)
MAKE_WEBHOOK_URL=
BREVO_API_KEY=
BREVO_SENDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
REPORT_FROM=OSINT Protege <seu-email@gmail.com>
PORT=5000
